#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# <NAME> installer — generated from the install-script-creator template.
# Fill every <PLACEHOLDER>, then DELETE every [SECTION:x] block that doesn't
# apply. A lean correct script beats a full-featured one with dead sections.
#
# One-liner (README):
#   curl -fsSL https://raw.githubusercontent.com/<OWNER>/<REPO>/main/install.sh | bash
# Flags: --no-cta  --all-harnesses  --no-harness   Env: SKIP_CTA=1 SKIP_HARNESS=1
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

NAME="<name>"                    # tool name (binary/CLI name)
REPO="<owner>/<repo>"
VERSION="<version-or-latest>"
BIN_DIR="$HOME/.local/bin"
INSTALL_DIR="$HOME/.${NAME}"     # project-owned data dir; adjust per profile

# ── helpers ──────────────────────────────────────────────────────────────────
tty_out() { [ -t 1 ]; }
tty_in()  { [ -t 0 ]; }
if tty_out; then
  B=$(printf '\033[1m'); G=$(printf '\033[1;32m'); Y=$(printf '\033[1;33m'); R=$(printf '\033[1;31m'); N=$(printf '\033[0m')
else B=""; G=""; Y=""; R=""; N=""; fi
info()  { printf '%s\n' "${G}==>${N} ${B}$*${N}"; }
warn()  { printf '%s\n' "${Y}warn:${N} $*" >&2; }
err()   { printf '%s\n' "${R}error:${N} $*" >&2; }
die()   { err "$*"; exit 1; }
generated() { printf '%s\n' ">>> generated: $1 <<<"; }

for arg in "$@"; do
  case "$arg" in
    --no-cta) SKIP_CTA=1 ;;
    --all-harnesses) ALL_HARNESS=1 ;;
    --no-harness) SKIP_HARNESS=1 ;;
    --help|-h) sed -n '3,10p' "$0"; exit 0 ;;
    *) die "Unknown option: $arg (supported: --no-cta, --all-harnesses, --no-harness)" ;;
  esac
done

# ── [SECTION: os-arch] OS / arch detection — keep always ────────────────────
OS="$(uname -s)"
case "$OS" in
  Linux*)     DISTRO="$(. /etc/os-release 2>/dev/null && echo "${ID:-unknown}")" ;;
  Darwin*)    DISTRO="macos" ;;
  *) die "Unsupported OS: $OS — Windows: use install.ps1 (irm <url> | iex)" ;;
esac
ARCH="$(uname -m)"
if [ "$DISTRO" = "macos" ] && sysctl -n hw.optional.arm64 2>/dev/null | grep -q 1; then
  ARCH="arm64"    # uname -m lies under Rosetta
fi
case "$ARCH" in x86_64|amd64) ARCH="x86_64" ;; aarch64|arm64) ARCH="arm64" ;;
  *) die "Unsupported architecture: $ARCH" ;; esac

# ── [SECTION: libc] only for prebuilt binary installs ───────────────────────
detect_libc() {
  if ldd --version 2>&1 | grep -qi musl || ls /lib/ld-musl-* >/dev/null 2>&1; then
    echo musl; else echo glibc; fi
}

# ── [SECTION: root-guard] refuse accidental root ────────────────────────────
if [ "${EUID:-$(id -u)}" -eq 0 ]; then
  die "Don't run as root — installs to \$HOME. Re-run as your user (override: --force-root)." # add flag if truly needed
fi

# ── [SECTION: prereqs] package-manager matrix — keep what you need ──────────
pm_install() {  # pm_install <pkg...>
  case "$DISTRO" in
    ubuntu|debian|linuxmint|pop)      sudo apt-get update -qq && sudo apt-get install -y "$@" ;;
    fedora|rhel|centos|rocky|alma)     sudo dnf install -y "$@" ;;
    arch|manjaro|cachyos|endeavouros) sudo pacman -Sy --needed --noconfirm "$@" ;;
    opensuse*)                        sudo zypper -n install "$@" ;;
    alpine)                           sudo apk add "$@" ;;
    macos)
      command -v brew >/dev/null || die "Homebrew required: https://brew.sh (install it, re-run)"
      brew install "$@" ;;
    *) die "Unknown distro '$DISTRO' — install manually: $*" ;;
  esac
}
need() {  # need <binary> <pkg-hint...>
  command -v "$1" >/dev/null 2>&1 && return 0
  info "Installing prerequisite: $1"
  pm_install "${@:2}"
  command -v "$1" >/dev/null || die "$1 still missing after install — install it, re-run"
}

