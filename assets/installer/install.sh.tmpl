# ── [SECTION: harness] AI-agent harness integration (MCP/skills offers) ─────
# Only if the project ships an MCP server or skills. See references/harness-matrix.md
# and references/mcp-wiring.md. Non-interactive (CI) defaults to skip.
detect_harnesses() {
  FOUND=""
  for h in claude codex opencode gemini qwen grok goose hermes zeroclaw omp omo pi droid; do
    command -v "$h" >/dev/null 2>&1 && FOUND="$FOUND $h"
  done
  echo "$FOUND"
}
run_harness_integration() {
  [ "${SKIP_HARNESS:-0}" = "1" ] && { info "Harness integration: skipped (SKIP_HARNESS)"; return 0; }
  local found; found="$(detect_harnesses)"
  [ -z "$found" ] && { info "No AI harnesses detected — skipping agent integration"; return 0; }
  if ! tty_in && [ "${ALL_HARNESS:-0}" != "1" ]; then
    info "Detected harnesses:${found} — non-interactive, skipping (re-run with --all-harnesses)"
    return 0
  fi
  if [ "${ALL_HARNESS:-0}" = "1" ]; then local answer="y";
  else read -rp "Configure ${found} ? [Y/n] " answer || answer="y"; fi
  case "$answer" in n|N) return 0 ;; esac
  # skills (registry harnesses): npx skills add "${REPO}" --agent '*' --skill '*' -y
  # family harnesses: manual placement per harness-matrix.md §2
  # MCP servers: registration snippets per mcp-wiring.md (absolute paths)
  info "Harness integration complete"
}

# ── [SECTION: verify] post-install verification — keep always ───────────────
verify() {
  command -v "$NAME" >/dev/null 2>&1 || die "$NAME not on PATH — open a new shell, or: export PATH=\"$BIN_DIR:\$PATH\""
  "$NAME" --version >/dev/null 2>&1 || warn "$NAME installed but --version failed — check $BIN_DIR/$NAME"
  info "Verified: $("$NAME" --version 2>/dev/null || echo 'installed')"
}

# ── [SECTION: cta] star + donate — NEVER delete ──────────────────────────────
print_cta() {
  [ "${SKIP_CTA:-0}" = "1" ] && return 0
  printf '\n%s\n' "──────────────────────────────────────────────────────"
  printf ' ⭐  Found %s useful? Star it:  https://github.com/%s\n' "$NAME" "$REPO"
  printf ' 💜  Support development:\n'
  printf '     GitHub Sponsors : https://github.com/sponsors/<sponsors-handle>\n'
  printf '     Razorpay (UPI)  : https://rzp.io/rzp/<handle>\n' # ← delete line if N/A
  printf '     Or run `%s donate` anytime.\n' "$NAME"           # ← keep only if CLI has the subcommand
  printf '%s\n' "──────────────────────────────────────────────────────"
}

# ── main ─────────────────────────────────────────────────────────────────────
info "Installing $NAME ($OS/$DISTRO $ARCH) → $BIN_DIR"
