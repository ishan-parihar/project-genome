#   Generated $cfg
# }

# ── [SECTION: harness] AI-agent harness integration (see references/mcp-wiring.md)
if (-not $SkipHarness) {
  $found = @('claude','codex','opencode','gemini','qwen','grok','goose','zeroclaw','pi','droid') |
    Where-Object { Get-Command $_ -ErrorAction SilentlyContinue }
  if ($found) {
    if ($AllHarnesses -or (-not [Environment]::UserInteractive -and $false)) {
      $answer = 'y'
    } else {
      $answer = Read-Host "Configure $($found -join ', ') ? [Y/n]"
    }
    if ($answer -notmatch '^n') {
      Write-Info 'Harness integration: see references/harness-matrix.md + mcp-wiring.md'
      # npx skills add "$Repo" --agent '*' --skill '*' -y   (skills projects)
      # per-harness MCP registration snippets (absolute paths)
    }
  }
}

# ── [SECTION: verify] post-install verification — keep always ───────────────
if (-not (Get-Command $Name -ErrorAction SilentlyContinue)) {
  Die "$Name not on PATH — open a NEW terminal, or rerun after: `$env:Path += `";$BinDir`""
}
Write-Info "Verified: $(& $Name --version 2>$null)"

# ── [SECTION: cta] star + donate — NEVER delete ──────────────────────────────
if (-not $NoCta) {
  Write-Host ''
  Write-Host '──────────────────────────────────────────────────────'
  Write-Host " ⭐  Found $Name useful? Star it:  https://github.com/$Repo"
  Write-Host ' 💜  Support development:'
  Write-Host '     GitHub Sponsors : https://github.com/sponsors/<sponsors-handle>'
  Write-Host '     Razorpay (UPI)  : https://rzp.io/rzp/<handle>'    # ← delete if N/A
  Write-Host "     Or run '$Name donate' anytime."                    # ← keep if CLI has it
  Write-Host '──────────────────────────────────────────────────────'
}

Write-Host ''
Write-Info "Done. Next steps:"
Write-Host "  1. $Name --help (open a NEW terminal first)"
