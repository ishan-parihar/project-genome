# ─────────────────────────────────────────────────────────────────────────────
# <NAME> installer (Windows) — generated from the install-script-creator template.
# Fill every <PLACEHOLDER>, then DELETE every [SECTION:x] block that doesn't apply.
#
# One-liner (README):  irm https://raw.githubusercontent.com/<OWNER>/<REPO>/main/install.ps1 | iex
# Run saved (if execution policy blocks): powershell -ExecutionPolicy Bypass -File install.ps1
# Flags: -NoCta  -AllHarnesses  -SkipHarness     Env: SKIP_CTA=1 SKIP_HARNESS=1
# ─────────────────────────────────────────────────────────────────────────────
[CmdletBinding()]
param(
  [switch]$NoCta,
  [switch]$AllHarnesses,
  [switch]$SkipHarness
)
$ErrorActionPreference = 'Stop'
if ($env:SKIP_CTA -eq '1') { $NoCta = $true }
if ($env:SKIP_HARNESS -eq '1') { $SkipHarness = $true }

$Name = '<name>'
$Repo = '<owner>/<repo>'
$BinDir = "$env:USERPROFILE\.$Name"        # or "$env:LOCALAPPDATA\$Name\bin"

function Write-Info($m) { Write-Host "==> $m" -ForegroundColor Green }
function Write-Warn($m) { Write-Host "warn: $m" -ForegroundColor Yellow -NoNewline; Write-Host '' }
function Die($m) { Write-Host "error: $m" -ForegroundColor Red; exit 1 }
function Generated($p) { Write-Host ">>> generated: $p <<<" }

# ── [SECTION: arch] arch detection — reg truth, PROCESSOR_ARCHITECTURE lies ──
$Arch = try {
  (Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Environment').PROCESSOR_ARCHITECTURE
} catch { $env:PROCESSOR_ARCHITECTURE }
switch ($Arch) {
  'AMD64'  { $Arch = 'x86_64' }
  'ARM64'  { $Arch = 'arm64' }
  default  { Die "Unsupported architecture: $Arch" }
}

# ── [SECTION: admin] no admin needed (user-scope install). If a system path is
# truly required, prompt once and use Start-Process -Verb RunAs for just that step.

# ── [SECTION: prereqs] winget → scoop → choco chain ─────────────────────────
function Install-Pkg($pkg, $wingetId, $chocoId) {
  if (Get-Command $pkg -ErrorAction SilentlyContinue) { return }
  Write-Info "Installing prerequisite: $pkg"
  if (Get-Command winget -ErrorAction SilentlyContinue) {
    winget install --id $wingetId -e --accept-source-agreements --accept-package-agreements
  } elseif (Get-Command scoop -ErrorAction SilentlyContinue) {
    scoop install $pkg
  } elseif (Get-Command choco -ErrorAction SilentlyContinue) {
    choco install $chocoId -y
  } else {
    Die "$pkg missing and no package manager found (winget/scoop/choco). Install it, re-run."
  }
  if (-not (Get-Command $pkg -ErrorAction SilentlyContinue)) {
    Die "$pkg still missing — open a NEW terminal (PATH refresh) and re-run"
  }
}

