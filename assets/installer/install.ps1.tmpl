# ── [SECTION: path] user PATH (idempotent) — keep if anything installs to PATH
$cur = [Environment]::GetEnvironmentVariable('Path', 'User')
if ($cur -notlike "*$BinDir*") {
  [Environment]::SetEnvironmentVariable('Path', "$cur;$BinDir", 'User')
  Generated 'user PATH'
}
$env:Path = "$env:Path;$BinDir"   # current session

